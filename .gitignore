# ============================================================
#  凭据与机器专属文件 —— 绝不进版本库
#  这些文件含真实内网 IP / 账号 / 明文密码 / 主机密钥指纹。
#  一旦 commit 进 git 历史，即使后续删除也仍然可被挖出，
#  所以是"绝不提交"，不是"提交后删掉"。
# ============================================================

# 服务器配置：含明文密码 + 真实 host + hostkey
servers.json
# 它的备份也会带上全部凭据，常见的漏网之处
servers.json.*
*.bak

# rclone 运行时生成的配置（obfuscated 密码 + 真实 host/user）
rclone.conf

# 挂载时记录的 SSH 主机公钥（含真实主机地址）
known_hosts
.srb-mounts/

# 日志（挂载测试日志含完整 net use 命令行，即含密码）
*.log

# ============================================================
#  第三方二进制与构建产物 —— 不进库，走 Release 附件
# ============================================================
node_modules/
runtime/
bin/plink.exe

# 分发包（含 node.exe 84MB / rclone.exe 82MB / MSI 安装包）
dist/

# 第三方工具（92MB，MIT/GPL，另行获取）
rclone/

# 实验脚本的运行时日志
experiments/_*.log

*.tmp

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
