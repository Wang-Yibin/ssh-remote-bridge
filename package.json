{
  "name": "ssh-remote-bridge",
  "version": "1.5.0",
  "description": "Prefer local mounted files and lightweight host computation, with persistent SSH for remote workloads - CLI + MCP server, multi-server, Windows only",
  "type": "module",
  "bin": {
    "ssh-remote": "remote-shell.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ssh",
    "mcp",
    "model-context-protocol",
    "sshfs",
    "windows",
    "remote-shell",
    "ai-agent"
  ],
  "license": "MIT",
  "files": [
    "*.cmd",
    "lib/",
    "mcp/",
    "tools/*.mjs",
    "tools/sshfs-runtime-lock.json",
    "remote-shell.mjs",
    "README.md",
    "README.en.md",
    "FIXES.zh-CN.md",
    "AUDIT-2026-10-19.md",
    "LICENSE",
    "servers.example.json",
    "tests/regression.mjs",
    "tests/remote-regression.mjs",
    "tests/lifecycle.mjs",
    "tests/live-stream.mjs",
    "tests/terminal-smoke.mjs",
    "tools/sshfs-condition-lifetimes.patch",
    "BUILD-SSHFS.md"
  ],
  "scripts": {
    "test": "node --no-warnings --experimental-vm-modules --test tests/regression.mjs",
    "test:lifecycle": "node tests/lifecycle.mjs",
    "remount": "node tools/restore_all.mjs",
    "check-mounts": "node tools/restore_all.mjs --check",
    "install:sshfs-runtime": "node tools/install_sshfs_runtime.mjs",
    "test:stream": "node experiments/test_stream.mjs",
    "test:complete": "node experiments/test_complete.mjs",
    "test:integration": "node experiments/mcp_dev_suite.mjs",
    "test:remote": "node tests/remote-regression.mjs",
    "test:mcp-live": "node tests/live-stream.mjs",
    "test:terminal": "node tests/terminal-smoke.mjs"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  }
}
