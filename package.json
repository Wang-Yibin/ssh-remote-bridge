{
  "name": "ssh-remote-bridge",
  "version": "1.0.0",
  "description": "Map a remote Linux server's home directory to a local Windows drive and forward every command to it - CLI + MCP server, multi-server, Windows only",
  "type": "module",
  "bin": {
    "ssh-remote": "remote-shell.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ssh",
    "mcp",
    "model-context-protocol",
    "sshfs",
    "windows",
    "remote-shell",
    "ai-agent"
  ],
  "license": "MIT",
  "files": [
    "*.cmd",
    "lib/",
    "mcp/",
    "tools/",
    "remote-shell.mjs",
    "README.md",
    "LICENSE",
    "servers.example.json"
  ],
  "scripts": {
    "test": "node experiments/mcp_dev_suite.mjs",
    "remount": "node tools/restore_all.mjs",
    "check-mounts": "node tools/restore_all.mjs --check"
  }
}